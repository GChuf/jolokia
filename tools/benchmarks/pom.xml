<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <artifactId>jolokia-tools-benchmarks</artifactId>
  <version>2.6.6-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>jolokia-tools-benchmarks</name>
  <description>Jolokia :: Tools :: JMH benchmarks</description>

  <parent>
    <groupId>org.jolokia</groupId>
    <artifactId>jolokia-parent</artifactId>
    <version>2.6.6-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <url>https://jolokia.org/</url>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- copies of the JSON lexer and parser sources, see maven-antrun-plugin -->
    <jflex.sources>${project.build.directory}/benchmark-jflex</jflex.sources>
    <parser.sources>${project.build.directory}/generated-sources/benchmark-parsers</parser.sources>
    <json.sources>${project.basedir}/../../json/src/main</json.sources>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jolokia</groupId>
      <artifactId>jolokia-json</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        A copy of the JSON lexer and parser of jolokia-json for each benchmarked buffer size, which differ only in
        %buffer and their package (org.jolokia.benchmarks.json.buffer<size>). The buffer size is a constant in the
        lexer generated by JFlex, so it can't be changed at runtime.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-parsers</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <macrodef name="parser">
                  <attribute name="size" />
                  <sequential>
                    <copy file="${json.sources}/jflex/jsonstrict.flex" tofile="${jflex.sources}/buffer@{size}.flex" overwrite="true">
                      <filterchain>
                        <linecontainsregexp negate="true">
                          <regexp pattern="^%buffer\s" />
                        </linecontainsregexp>
                        <tokenfilter>
                          <replaceregex pattern="^package org\.jolokia\.json\.parser;" replace="package org.jolokia.benchmarks.json.buffer@{size};" />
                          <replaceregex pattern="^%class Yylex$" replace="%class Yylex&#10;%buffer @{size}" />
                        </tokenfilter>
                      </filterchain>
                    </copy>
                    <copy todir="${parser.sources}/org/jolokia/benchmarks/json/buffer@{size}" overwrite="true">
                      <fileset dir="${json.sources}/java/org/jolokia/json/parser" includes="*.java" excludes="package-info.java" />
                      <filterchain>
                        <tokenfilter>
                          <replaceregex pattern="^package org\.jolokia\.json\.parser;" replace="package org.jolokia.benchmarks.json.buffer@{size};" />
                        </tokenfilter>
                      </filterchain>
                    </copy>
                  </sequential>
                </macrodef>
                <parser size="256" />
                <parser size="512" />
                <parser size="1024" />
                <parser size="2048" />
                <parser size="4096" />
                <!-- JFlex default -->
                <parser size="16384" />
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>de.jflex</groupId>
        <artifactId>jflex-maven-plugin</artifactId>
        <version>1.9.1</version>
        <executions>
          <execution>
            <id>generate-lexers</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <lexDefinitions>
                <lexDefinition>${jflex.sources}</lexDefinition>
              </lexDefinitions>
              <encodingName>UTF-8</encodingName>
              <jlex>true</jlex>
              <backup>false</backup>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>${plugin.org.codehaus.mojo.build-helper-maven-plugin}</version>
        <executions>
          <execution>
            <id>add-parser-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${parser.sources}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.openjdk.jmh</groupId>
              <artifactId>jmh-generator-annprocess</artifactId>
              <version>${version.org.openjdk.jmh}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>benchmarks</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.openjdk.jmh.Main</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
